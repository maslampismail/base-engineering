{
  "name": "base_eng",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "pages:build": "npx @cloudflare/next-on-pages",
    "start": "next start -H 0.0.0.0",
    "lint": "next lint",
    "migrate:d1:create": "wrangler d1 migrations create base_db",
    "migrate:d1:apply": "wrangler d1 migrations apply base_db --remote",
    "migrate:d1:list": "wrangler d1 migrations list base_db --remote",
    "migrate:d1:local": "wrangler d1 migrations apply base_db --local"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1126.0",
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "lucide-react": "^1.40.0",
    "next": "14.2.15",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@cloudflare/next-on-pages": "^1.13.15",
    "prisma": "^5.22.0",
    "wrangler": "^3.114.17"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
